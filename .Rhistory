install.packages("duckdb")
install.packages("duckdb")
source("scripts/refresh.R")
remove.packages("duckdb")
install.packages("duckdb")
library(duckdb)
con <- dbConnect(duckdb::duckdb())
dbGetQuery(con, "SELECT version()")
dbDisconnect(con)
source("scripts/refresh.R")
source("scripts/refresh.R")
library(duckdb)
library(DBI)
SOURCE_DB <- file.path(Sys.getenv("USERPROFILE"), "projects/data-lake/data_lake/mca_env_base.duckdb")
cat("File exists:", file.exists(SOURCE_DB), "\n")
drv <- duckdb(dbdir = SOURCE_DB)
con <- dbConnect(drv)
dbGetQuery(con, "SELECT version()")
dbDisconnect(con)
duckdb_shutdown(drv)
source("scripts/refresh.R")
rlang::last_trace()
library(duckdb)
con <- dbConnect(duckdb::duckdb(), dbdir = SOURCE_DB, read_only = TRUE)
SOURCE_DB <- file.path(Sys.getenv("USERPROFILE"), "projects/data-lake/data_lake/mca_env_base.duckdb")
con <- dbConnect(duckdb::duckdb(), dbdir = SOURCE_DB, read_only = TRUE)
dbGetQuery(con, "SELECT 42")
dbDisconnect(con, shutdown = TRUE)
source("scripts/refresh.R")
library(arrow)
library(pins)
library(duckdb)
library(DBI)
